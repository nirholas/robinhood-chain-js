{
  "name": "hood-js",
  "version": "0.1.1",
  "description": "The five-lines-to-your-first-trade wrapper for Robinhood Chain (ID 4663). One import, sensible defaults, promise-first, browser + Node: stock prices, portfolios, trending memecoins, launch streams, and swaps.",
  "keywords": [
    "robinhood",
    "robinhood-chain",
    "stock-tokens",
    "memecoins",
    "usdg",
    "swap",
    "viem",
    "web3",
    "easy",
    "sdk"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "nirholas (https://x.com/nichxbt)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/robinhood-chain-js.git"
  },
  "homepage": "https://nirholas.github.io/robinhood-chain-js/",
  "bugs": {
    "url": "https://github.com/nirholas/robinhood-chain-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:live": "vitest run tests/live --testTimeout 120000",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm test && npm run size"
  },
  "dependencies": {
    "hoodchain": "^0.1.0"
  },
  "peerDependencies": {
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "gzip-size": "^7.0.0",
    "hoodchain": "file:../robinhood-chain-sdk",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "viem": "^2.55.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite@>=7.0.0 <=7.3.6": "^7.3.7",
    "@vitest/mocker@>=2.1.0-beta.7.0.0 <4.1.12": "^4.1.12",
    "@vitest/mocker@>=2.1.0 <4.1.11": "^4.1.12",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
    "tinypool@<=2.1.0": "^2.1.2",
    "tinypool@<2.1.2": "^2.1.2",
    "vitest@>=2.1.0 <4.1.11": "^4.1.11",
    "postcss@<=8.5.22": "^8.5.23",
    "postcss@<=8.5.17": "^8.5.23",
    "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
  }
}
